# Copy to .env.local (never commit real keys).
# Register and Contact forms send email through Resend: https://resend.com
# Without these, forms print emails to the terminal in development and show a
# "call us" fallback in production.

# API key from Resend (Settings > API Keys)
RESEND_API_KEY=

# Sender on a domain verified in Resend
EMAIL_FROM="Elevation Inspections <connect@elevationtninspections.com>"

# Where form submissions go (defaults to connect@elevationtninspections.com)
EMAIL_TO=connect@elevationtninspections.com
